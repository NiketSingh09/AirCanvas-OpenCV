import cv2
import numpy as np

# Setup webcam
cap = cv2.VideoCapture(0)

# Expanded Color Palette (in BGR format)
colors = [
    (255, 0, 0),      # Blue
    (0, 255, 0),      # Green
    (0, 0, 255),      # Red
    (0, 255, 255),    # Yellow
    (0, 165, 255),    # Orange
    (255, 0, 255),    # Magenta / Purple
    (255, 255, 0),    # Cyan
    (0, 0, 0)         # Eraser
]
color_names = ["BLUE", "GREEN", "RED", "YELLOW", "ORANGE", "PURPLE", "CYAN", "ERASER"]
current_color = colors[0]

# --- HSV COLOR CALIBRATION (Dark Blue cap preset) ---
Lower_hsv = np.array([95, 100, 30])
Upper_hsv = np.array([135, 255, 255])

# Canvas overlay initialization
ret, frame = cap.read()
h, w, _ = frame.shape
canvas = np.zeros((h, w, 3), dtype=np.uint8)

prev_x, prev_y = 0, 0
brush_thickness = 5
eraser_thickness = 50

def draw_header(img):
    """Draw top control palette with dynamic column widths."""
    total_items = len(colors) + 1  # 8 colors + 1 CLEAR button
    col_w = w // total_items

    # Draw color boxes
    for i in range(len(colors)):
        cv2.rectangle(img, (i * col_w, 0), ((i + 1) * col_w, 60), colors[i], -1)
        # Choose text color based on background brightness
        text_color = (0, 0, 0) if i in [3, 4, 6] else (255, 255, 255)
        cv2.putText(img, color_names[i], (i * col_w + 5, 40),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.45, text_color, 2)
    
    # Draw CLEAR button on far right
    cv2.rectangle(img, (len(colors) * col_w, 0), (w, 60), (100, 100, 100), -1)
    cv2.putText(img, "CLEAR", (len(colors) * col_w + 5, 40),
                cv2.FONT_HERSHEY_SIMPLEX, 0.45, (255, 255, 255), 2)

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break

    frame = cv2.flip(frame, 1)
    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    draw_header(frame)

    # Filter out target object color
    mask = cv2.inRange(hsv, Lower_hsv, Upper_hsv)
    mask = cv2.erode(mask, None, iterations=2)
    mask = cv2.dilate(mask, None, iterations=2)

    # Track largest object contour
    contours, _ = cv2.findContours(mask.copy(), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    
    if len(contours) > 0:
        c = max(contours, key=cv2.contourArea)
        if cv2.contourArea(c) > 500:  # Minimum size threshold
            ((x, y), radius) = cv2.minEnclosingCircle(c)
            center = (int(x), int(y))
            cv2.circle(frame, center, int(radius), (0, 255, 255), 2)

            # Palette Selection Zone
            if center[1] < 60:
                prev_x, prev_y = 0, 0
                total_items = len(colors) + 1
                col_w = w // total_items
                click_idx = center[0] // col_w
                if click_idx < len(colors):
                    current_color = colors[click_idx]
                elif click_idx == len(colors):
                    canvas = np.zeros((h, w, 3), dtype=np.uint8)
            else:
                # Drawing Zone
                if prev_x == 0 and prev_y == 0:
                    prev_x, prev_y = center[0], center[1]
                
                thickness = eraser_thickness if current_color == (0, 0, 0) else brush_thickness
                cv2.line(canvas, (prev_x, prev_y), center, current_color, thickness)
                prev_x, prev_y = center[0], center[1]
    else:
        prev_x, prev_y = 0, 0

    # Merge drawn lines onto camera output
    img_gray = cv2.cvtColor(canvas, cv2.COLOR_BGR2GRAY)
    _, img_inv = cv2.threshold(img_gray, 20, 255, cv2.THRESH_BINARY_INV)
    img_inv = cv2.cvtColor(img_inv, cv2.COLOR_GRAY2BGR)
    frame = cv2.bitwise_and(frame, img_inv)
    frame = cv2.bitwise_or(frame, canvas)

    cv2.imshow("Air Canvas", frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
